generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model almacen {
  id                                                                      BigInt                  @id @default(autoincrement())
  sucursal_id                                                             BigInt
  codigo                                                                  String                  @db.VarChar(30)
  nombre                                                                  String                  @db.VarChar(120)
  descripcion                                                             String?
  activo                                                                  Boolean                 @default(true)
  creado_en                                                               DateTime                @default(now()) @db.Timestamptz(6)
  actualizado_en                                                          DateTime                @default(now()) @db.Timestamptz(6)
  sucursal                                                                sucursal                @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  compra                                                                  compra[]
  existencia                                                              existencia[]
  movimiento_inventario                                                   movimiento_inventario[]
  transferencia_almacen_transferencia_almacen_almacen_destino_idToalmacen transferencia_almacen[] @relation("transferencia_almacen_almacen_destino_idToalmacen")
  transferencia_almacen_transferencia_almacen_almacen_origen_idToalmacen  transferencia_almacen[] @relation("transferencia_almacen_almacen_origen_idToalmacen")
  venta                                                                   venta[]

  @@unique([sucursal_id, codigo], map: "uq_almacen_sucursal_codigo")
  @@index([sucursal_id], map: "idx_almacen_sucursal")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auditoria {
  id               BigInt   @id @default(autoincrement())
  usuario_id       BigInt?
  tabla            String   @db.VarChar(100)
  registro_id      BigInt?
  accion           String   @db.VarChar(20)
  datos_anteriores Json?
  datos_nuevos     Json?
  ip_origen        String?  @db.Inet
  creado_en        DateTime @default(now()) @db.Timestamptz(6)
  usuario          usuario? @relation(fields: [usuario_id], references: [id], onUpdate: NoAction)

  @@index([tabla, registro_id, creado_en(sort: Desc)], map: "idx_auditoria_tabla_registro")
}

model caja {
  id             BigInt       @id @default(autoincrement())
  sucursal_id    BigInt
  codigo         String       @db.VarChar(30)
  nombre         String       @db.VarChar(100)
  activo         Boolean      @default(true)
  creado_en      DateTime     @default(now()) @db.Timestamptz(6)
  actualizado_en DateTime     @default(now()) @db.Timestamptz(6)
  sucursal       sucursal     @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sesion_caja    sesion_caja?

  @@unique([sucursal_id, codigo], map: "uq_caja_sucursal_codigo")
}

model categoria {
  id                 BigInt      @id @default(autoincrement())
  empresa_id         BigInt
  categoria_padre_id BigInt?
  nombre             String      @db.VarChar(120)
  descripcion        String?
  activo             Boolean     @default(true)
  creado_en          DateTime    @default(now()) @db.Timestamptz(6)
  actualizado_en     DateTime    @default(now()) @db.Timestamptz(6)
  categoria          categoria?  @relation("categoriaTocategoria", fields: [categoria_padre_id], references: [id], onUpdate: NoAction)
  other_categoria    categoria[] @relation("categoriaTocategoria")
  empresa            empresa     @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  producto           producto[]

  @@unique([empresa_id, nombre], map: "uq_categoria_empresa_nombre")
  @@index([empresa_id], map: "idx_categoria_empresa")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cliente {
  id                BigInt              @id @default(autoincrement())
  empresa_id        BigInt
  codigo            String              @db.VarChar(40)
  nombre            String              @db.VarChar(180)
  rfc               String?             @db.VarChar(20)
  email             String?             @db.VarChar(180)
  telefono          String?             @db.VarChar(30)
  limite_credito    Decimal             @default(0) @db.Decimal(14, 2)
  dias_credito      Int                 @default(0)
  activo            Boolean             @default(true)
  creado_en         DateTime            @default(now()) @db.Timestamptz(6)
  actualizado_en    DateTime            @default(now()) @db.Timestamptz(6)
  empresa           empresa             @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cliente_direccion cliente_direccion[]
  cotizacion        cotizacion[]
  orden_venta       orden_venta[]
  pedido_cliente    pedido_cliente[]
  venta             venta[]

  @@unique([empresa_id, codigo], map: "uq_cliente_empresa_codigo")
  @@index([empresa_id], map: "idx_cliente_empresa")
  @@index([nombre], map: "idx_cliente_nombre")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cliente_direccion {
  id              BigInt  @id @default(autoincrement())
  cliente_id      BigInt
  tipo            String  @default("FISCAL") @db.VarChar(20)
  calle           String? @db.VarChar(180)
  numero_exterior String? @db.VarChar(30)
  numero_interior String? @db.VarChar(30)
  colonia         String? @db.VarChar(120)
  municipio       String? @db.VarChar(120)
  estado          String? @db.VarChar(120)
  codigo_postal   String? @db.VarChar(15)
  pais            String  @default("MÃ©xico") @db.VarChar(80)
  es_principal    Boolean @default(false)
  cliente         cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model compra {
  id                BigInt           @id @default(autoincrement())
  empresa_id        BigInt
  sucursal_id       BigInt
  almacen_id        BigInt
  proveedor_id      BigInt
  usuario_id        BigInt
  folio             String           @db.VarChar(50)
  factura_proveedor String?          @db.VarChar(80)
  fecha             DateTime         @default(now()) @db.Timestamptz(6)
  estado            String           @default("BORRADOR") @db.VarChar(20)
  subtotal          Decimal          @default(0) @db.Decimal(14, 2)
  descuento         Decimal          @default(0) @db.Decimal(14, 2)
  impuesto          Decimal          @default(0) @db.Decimal(14, 2)
  total             Decimal          @default(0) @db.Decimal(14, 2)
  observaciones     String?
  creado_en         DateTime         @default(now()) @db.Timestamptz(6)
  actualizado_en    DateTime         @default(now()) @db.Timestamptz(6)
  almacen           almacen          @relation(fields: [almacen_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  empresa           empresa          @relation(fields: [empresa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proveedor         proveedor        @relation(fields: [proveedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sucursal          sucursal         @relation(fields: [sucursal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario           usuario          @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  compra_detalle    compra_detalle[]
  compra_pago       compra_pago[]

  @@unique([sucursal_id, folio], map: "uq_compra_sucursal_folio")
  @@index([estado, fecha(sort: Desc)], map: "idx_compra_estado_fecha")
  @@index([fecha(sort: Desc)], map: "idx_compra_fecha")
  @@index([proveedor_id, fecha(sort: Desc)], map: "idx_compra_proveedor_fecha")
}

